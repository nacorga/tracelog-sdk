{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "include-v-in-tag": false,
  "tag-separator": "@",
  "separate-pull-requests": false,
  "bootstrap-sha": "f1ec5e90f61ec3833ba0fe38a90abe399d7dff6a",
  "changelog-sections": [
    { "type": "feat", "section": "Added" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Fixed" },
    { "type": "refactor", "section": "Changed" },
    { "type": "docs", "hidden": true },
    { "type": "chore", "hidden": true },
    { "type": "test", "hidden": true }
  ],
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "tracelog-sdk",
      "components": ["event-contract", "capture-core", "capture-web"]
    }
  ],
  "packages": {
    "packages/event-contract": {
      "component": "event-contract",
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["README.md"]
    },
    "packages/capture-core": {
      "component": "capture-core",
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["README.md"]
    },
    "packages/capture-web": {
      "component": "capture-web",
      "changelog-path": "CHANGELOG.md",
      "extra-files": ["README.md"]
    }
  }
}
