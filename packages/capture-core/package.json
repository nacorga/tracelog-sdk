{
  "name": "@tracelog/capture-core",
  "version": "1.0.0",
  "description": "The TraceLog capture engine, with no DOM and no browser global: what platform artifacts bind inside sandboxes that have neither.",
  "keywords": [
    "conversion",
    "conversion-tracking",
    "tracking-plan",
    "consent",
    "sandbox"
  ],
  "homepage": "https://tracelog.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nacorga/tracelog-sdk.git",
    "directory": "packages/capture-core"
  },
  "bugs": {
    "url": "https://github.com/nacorga/tracelog-sdk/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tracelog/event-contract": "workspace:*"
  }
}
