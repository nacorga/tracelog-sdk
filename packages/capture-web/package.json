{
  "name": "@tracelog/capture-web",
  "version": "1.0.0",
  "description": "The TraceLog browser capture runtime: consent-first, pinned per version.",
  "keywords": [
    "conversion",
    "conversion-tracking",
    "tracking-plan",
    "consent",
    "gdpr",
    "first-party"
  ],
  "homepage": "https://tracelog.io",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/tracelog.esm.js",
  "module": "./dist/tracelog.esm.js",
  "types": "./dist/tracelog.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tracelog.d.ts",
      "default": "./dist/tracelog.esm.js"
    },
    "./tracelog.iife.js": "./dist/tracelog.iife.js"
  },
  "files": [
    "dist/tracelog.esm.js",
    "dist/tracelog.iife.js",
    "dist/tracelog.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build.mjs",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@tracelog/capture-core": "workspace:*"
  }
}
