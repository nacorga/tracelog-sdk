{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.package.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "outDir": "${configDir}/dist",
    "sourceMap": true
  },
  "exclude": ["${configDir}/src/**/*.test.ts", "${configDir}/src/**/*.test.tsx"]
}
